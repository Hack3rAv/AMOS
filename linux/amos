#!/usr/bin/env bash
# ==============================================================================
#  AMOS CLI - Avrodip's Minecraft Operating System Control Utility
# ==============================================================================

SERVICE_NAME="amos.service"
INSTALL_DIR="/opt/amos"
PORT=3001

# Color definitions
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

show_banner() {
    echo -e "${CYAN}"
    echo "    _    __  __  ___  ____  "
    echo "   / \  |  \/  |/ _ \/ ___| "
    echo "  / _ \ | |\/| | | | \___ \ "
    echo " / ___ \| |  | | |_| |___) |"
    echo "/_/   \_\_|  |_|\___/|____/ "
    echo -e "${NC}"
    echo -e "${PURPLE}Avrodip's Minecraft Operating System CLI v1.0${NC}"
    echo -e "${CYAN}------------------------------------------------${NC}"
}

get_ip_addresses() {
    LOCAL_IPS=$(hostname -I 2>/dev/null || ip addr show | grep -oP 'inet \K[\d.]+' | grep -v '127.0.0.1')
    PUBLIC_IP=$(curl -s --max-time 2 https://api.ipify.org 2>/dev/null || echo "Unavailable")
}

cmd_status() {
    show_banner
    echo -e "${YELLOW}[-] Checking AMOS Daemon Status...${NC}"
    
    if systemctl is-active --quiet "$SERVICE_NAME"; then
        echo -e "Service Status:  ${GREEN}[+] ACTIVE (RUNNING)${NC}"
    else
        echo -e "Service Status:  ${RED}[-] INACTIVE (STOPPED)${NC}"
    fi

    if systemctl is-enabled --quiet "$SERVICE_NAME" 2>/dev/null; then
        echo -e "Boot Auto-Start: ${GREEN}ENABLED${NC}"
    else
        echo -e "Boot Auto-Start: ${YELLOW}DISABLED${NC}"
    fi

    echo ""
    get_ip_addresses
    echo -e "${CYAN}[ Portal Access URLs ]${NC}"
    for ip in $LOCAL_IPS; do
        echo -e "  Local Network: ${GREEN}http://${ip}:${PORT}${NC}"
    done
    if [ "$PUBLIC_IP" != "Unavailable" ]; then
        echo -e "  Public Network: ${GREEN}http://${PUBLIC_IP}:${PORT}${NC}"
    fi
    echo ""

    # Check if Minecraft server java process is active
    MC_PID=$(pgrep -f "server.jar" 2>/dev/null)
    if [ -n "$MC_PID" ]; then
        echo -e "Minecraft Server: ${GREEN}[+] ONLINE (PID: $MC_PID)${NC}"
    else
        echo -e "Minecraft Server: ${YELLOW}[-] OFFLINE (Awaiting start from Web Panel)${NC}"
    fi
    echo ""
}

cmd_start() {
    echo -e "${GREEN}[+] Starting AMOS Service...${NC}"
    sudo systemctl start "$SERVICE_NAME"
    sleep 2
    cmd_status
}

cmd_stop() {
    echo -e "${RED}[-] Stopping AMOS Service...${NC}"
    sudo systemctl stop "$SERVICE_NAME"
    echo -e "${YELLOW}AMOS Service stopped.${NC}"
}

cmd_restart() {
    echo -e "${YELLOW}[~] Restarting AMOS Service...${NC}"
    sudo systemctl restart "$SERVICE_NAME"
    sleep 2
    cmd_status
}

cmd_enable() {
    echo -e "${GREEN}[+] Enabling AMOS system boot auto-start...${NC}"
    sudo systemctl enable "$SERVICE_NAME"
    echo -e "${GREEN}AMOS will now automatically start on system boot.${NC}"
}

cmd_disable() {
    echo -e "${YELLOW}[-] Disabling AMOS system boot auto-start...${NC}"
    sudo systemctl disable "$SERVICE_NAME"
    echo -e "${YELLOW}AMOS boot auto-start disabled.${NC}"
}

cmd_ip() {
    show_banner
    get_ip_addresses
    echo -e "${CYAN}[ AMOS Web Panel Access Portal ]${NC}"
    for ip in $LOCAL_IPS; do
        echo -e "  -> Local URL:  ${GREEN}http://${ip}:${PORT}${NC}"
    done
    if [ "$PUBLIC_IP" != "Unavailable" ]; then
        echo -e "  -> Public URL: ${GREEN}http://${PUBLIC_IP}:${PORT}${NC}"
    fi
    echo ""
}

cmd_logs() {
    echo -e "${CYAN}[+] Streaming Live AMOS Logs (Press Ctrl+C to exit)...${NC}"
    sudo journalctl -u "$SERVICE_NAME" -f -n 100
}

cmd_uninstall() {
    if [ -f "$INSTALL_DIR/linux/uninstall.sh" ]; then
        sudo bash "$INSTALL_DIR/linux/uninstall.sh"
    elif [ -f "$(dirname "${BASH_SOURCE[0]}")/uninstall.sh" ]; then
        sudo bash "$(dirname "${BASH_SOURCE[0]}")/uninstall.sh"
    else
        echo -e "${RED}[!] Error: Could not locate uninstall.sh${NC}"
        exit 1
    fi
}

cmd_help() {
    show_banner
    echo "Usage: amos [command]"
    echo ""
    echo "Commands:"
    echo "  status     - Show AMOS daemon status, server state & portal IPs"
    echo "  ip         - Display web panel portal access URLs & IP addresses"
    echo "  start      - Start the AMOS background daemon service"
    echo "  stop       - Stop the AMOS background daemon service"
    echo "  restart    - Restart the AMOS background daemon service"
    echo "  enable     - Enable AMOS daemon auto-start on system boot"
    echo "  disable    - Disable AMOS daemon auto-start on system boot"
    echo "  logs       - Tail live system logs from the AMOS daemon"
    echo "  uninstall  - Cleanly uninstall AMOS with option to save worlds"
    echo "  help       - Show this help menu"
    echo ""
}

case "$1" in
    status)
        cmd_status
        ;;
    ip)
        cmd_ip
        ;;
    start)
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    restart)
        cmd_restart
        ;;
    enable)
        cmd_enable
        ;;
    disable)
        cmd_disable
        ;;
    logs|log)
        cmd_logs
        ;;
    uninstall)
        cmd_uninstall
        ;;
    help|--help|-h|"")
        cmd_help
        ;;
    *)
        echo -e "${RED}Unknown command: $1${NC}"
        cmd_help
        exit 1
        ;;
esac